# Copy to .env.local for local work. Never commit real values.
# Browser mode is the default and needs none of these. Everything below is optional.

# The model repo the visitor's browser downloads (int8 ONNX made by tools/export_onnx.py).
# NEXT_PUBLIC_MODEL_ID=blackirron/hinglish-gpt2-onnx
# Pin a commit hash in production so the files cannot change.
# NEXT_PUBLIC_MODEL_REVISION=main
# "hub" downloads from Hugging Face, "local" serves from web/public/models (tests, offline).
# NEXT_PUBLIC_MODEL_SOURCE=hub

# --- Server mode only (NEXT_PUBLIC_ENGINE=server) ---
# NEXT_PUBLIC_ENGINE=server
# INFERENCE_API_URL=http://localhost:8000
# Must equal API_SHARED_SECRET on the API. Server side only, never prefix with NEXT_PUBLIC_.
# API_SHARED_SECRET=change-me-to-a-long-random-string-32-chars
# RATE_LIMIT_PER_MIN=20
